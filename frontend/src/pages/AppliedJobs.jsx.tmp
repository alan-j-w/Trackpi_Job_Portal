import React, { useState, useEffect } from 'react';
import axios from 'axios';
import { Link } from 'react-router-dom';
import Navbar from '../components/Navbar';
import toast from 'react-hot-toast';

import config from '../config';

const AppliedJobs = () => {
    const [applications, setApplications] = useState([]);
    const [loading, setLoading] = useState(true);

    useEffect(() => {
        const fetchAppliedJobs = async () => {
            try {
                const token = localStorage.getItem('token');
                if (!token) {
                    toast.error("Please login to view applied jobs");
                    setLoading(false);
                    return;
                }

                const configAuth = {
                    headers: {
                        Authorization: `Bearer ${token}`
                    }
                };

                const res = await axios.get(`${config.API_URL}/api/applications/my-applications`, configAuth);
                if (res.data.success) {
                    setApplications(res.data.applications);
                }
            } catch (error) {
                console.error("Error fetching applied jobs:", error);
                // toast.error("Failed to fetch applied jobs");
            } finally {
                setLoading(false);
            }
        };

        fetchAppliedJobs();
    }, []);

    // Helper to get badge color based on status
    const getStatusBadge = (status) => {
        // Mock status logic if not available in job
        if (status === 'urgent') return "bg-[#FF4F4F] text-white"; // Red for Urgent
        if (status === 'new') return "bg-[#4CAF50] text-white"; // Green for New
        return "hidden";
    };

    return (
        <div className="bg-[#F8F9FB] min-h-screen pb-20 font-sans">
            <Navbar />

            <div className="max-w-[1440px] mx-auto px-4 md:px-12 pt-16">
                {/* Header */}
                <div className="mb-12">
                    <h1 className="text-[32px] font-bold text-black ml-2">Applied vacancies</h1>
                </div>

                {loading ? (
                    <div className="flex justify-center items-center h-64">
                        <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-[#FFB300]"></div>
                    </div>
                ) : applications.length === 0 ? (
                    <div className="text-center py-20">
                        <h2 className="text-xl font-semibold text-gray-600">You haven't applied to any jobs yet.</h2>
                        <Link to="/jobs" className="mt-4 inline-block bg-[#FFB300] text-black px-8 py-3 rounded-full font-bold shadow-lg hover:bg-[#ffaa00] transition-all">
                            Browse Jobs
                        </Link>
                    </div>
                ) : (
                    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-y-12 gap-x-8 px-2">
                        {applications.map((app) => {
                            const job = app.jobId;
                            if (!job) return null;

                            return (
                                <div key={app._id} className="bg-white rounded-[40px] p-8 shadow-[0_15px_50px_-15px_rgba(0,0,0,0.08)] flex flex-col items-start border border-gray-50 relative overflow-hidden transition-all hover:shadow-[0_20px_60px_-10px_rgba(0,0,0,0.12)]">

                                    {/* 1. Header: Logo, Info, Verified */}
                                    <div className="flex justify-between items-start w-full mb-6">
                                        <div className="flex gap-4">
                                            {/* Company Logo */}
                                            <div className="w-[60px] h-[60px] flex items-center justify-center p-1">
                                                <img
                                                    src="/company-logo-placeholder.png"
                                                    alt={job.company}
                                                    className="w-full h-full object-contain"
                                                    onError={(e) => {
                                                        // Fallback for logos
                                                        e.target.src = "https://via.placeholder.com/60/FFB300/FFFFFF?text=Logo";
                                                    }}
                                                />
                                            </div>

                                            <div className="flex flex-col pt-1">
                                                <h3 className="font-bold text-lg text-black leading-tight">{job.company || "TrackPi Privet Limited"}</h3>
                                                <p className="text-gray-400 text-sm">{job.location || "Kochi, Kerala"}</p>
                                            </div>
                                        </div>

                                        {/* Verified Company Badge */}
                                        <div className="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-[#FFD6A4] bg-[#FFF0E5] shadow-sm mt-1">
                                            <div className="w-4 h-4 rounded-full bg-[#FF5722] flex items-center justify-center">
                                                <svg width="10" height="8" viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <path d="M10 2L4.5 7.5L2 5" stroke="white" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" />
                                                </svg>
                                            </div>
                                            <span className="text-[10px] font-bold text-[#FF5722] whitespace-nowrap">Verified Company</span>
                                        </div>
                                    </div>

                                    {/* 2. Job Title & Description */}
                                    <h2 className="text-xl font-bold text-black mb-3">{job.title}</h2>
                                    <p className="text-[#827E7E] text-[13px] leading-relaxed mb-6 font-medium">
                                        {job.description || "Office ipsum you must be muted. Unpack team productive club productive didn't alpha 4-blocker pulling need. You competitors creep room and that management horse charts baked pulling."}
                                    </p>

                                    {/* 3. Stats Row 1 (Iconic) */}
                                    <div className="grid grid-cols-3 gap-y-3 w-full mb-3">
                                        <div className="flex items-center gap-2 text-black text-[11px] font-bold">
                                            <div className="w-3.5 h-3.5 bg-[#FFB300] rounded-sm flex items-center justify-center text-white text-[8px]">
                                                <i className="ri-briefcase-4-fill"></i>
                                            </div>
                                            {job.jobType || "Full time"}
                                        </div>
                                        <div className="flex items-center gap-2 text-black text-[11px] font-bold">
                                            <div className="w-3.5 h-3.5 bg-[#FFB300] rounded-sm flex items-center justify-center text-white text-[8px]">
                                                <i className="ri-graduation-cap-fill"></i>
                                            </div>
                                            Any postgraduation
                                        </div>
                                        <div className="flex items-center gap-2 text-black text-[11px] font-bold">
                                            <div className="w-3.5 h-3.5 bg-[#FFB300] rounded-sm flex items-center justify-center text-white text-[8px]">
                                                <i className="ri-home-4-fill"></i>
                                            </div>
                                            Work from home
                                        </div>
                                    </div>

                                    {/* 4. Stats Row 2 (Iconic) */}
                                    <div className="grid grid-cols-3 gap-y-3 w-full mb-8">
                                        <div className="flex items-center gap-2 text-black text-[11px] font-bold">
                                            <div className="w-3.5 h-3.5 bg-[#FFB300] rounded-sm flex items-center justify-center text-white text-[8px]">
                                                <i className="ri-user-heart-fill"></i>
                                            </div>
                                            {job.gender || "Female"}
                                        </div>
                                        <div className="flex items-center gap-2 text-black text-[11px] font-bold">
                                            <div className="w-3.5 h-3.5 bg-[#FFB300] rounded-sm flex items-center justify-center text-white text-[8px]">
                                                <i className="ri-money-dollar-circle-fill"></i>
                                            </div>
                                            {job.salary || "35,000 rs - 40,000 rs"}
                                        </div>
                                        <div className="flex items-center gap-2 text-black text-[11px] font-bold">
                                            <div className="w-3.5 h-3.5 bg-[#FFB300] rounded-sm flex items-center justify-center text-white text-[8px]">
                                                <i className="ri-time-fill"></i>
                                            </div>
                                            Minimum one year experience in sales
                                        </div>
                                    </div>

                                    {/* 5. Footer Actions */}
                                    <div className="w-full mt-auto">
                                        <div className="flex items-center justify-between mb-4 pr-1">
                                            {/* Work from home badge */}
                                            <div className="flex items-center gap-3 px-4 py-2.5 rounded-full border border-[#FFB300] bg-white text-black text-[13px] font-bold shadow-sm">
                                                Work from home
                                                <div className="w-5 h-5 bg-[#FFB300] rounded-full flex items-center justify-center text-white">
                                                    <i className="ri-home-4-fill text-xs"></i>
                                                </div>
                                            </div>

                                            {/* Applied Button */}
                                            <button className="bg-[#4CAF50] text-white px-10 py-2.5 rounded-xl font-bold text-sm shadow-md transition-all cursor-default">
                                                Applied
                                            </button>
                                        </div>

                                        <div className="flex items-center justify-between w-full">
                                            {/* Ribbon logic will go here if needed */}
                                        </div>
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                )}
            </div>
        </div>
    );
};
export default AppliedJobs;
